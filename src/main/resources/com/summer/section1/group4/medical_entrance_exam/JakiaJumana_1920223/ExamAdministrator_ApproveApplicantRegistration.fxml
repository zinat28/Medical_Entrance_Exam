<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.group4medicalexamsimulation.JakiaJumana_1920223.Controller.ExamAdministrator_ApproveApplicantRegistrationController">
   <children>
      <Label layoutX="20.0" layoutY="20.0" text="Approve Applicant Registration" />

      <Label layoutX="20.0" layoutY="60.0" text="Application ID:" />
      <TextField fx:id="applicationIdTextField" layoutX="130.0" layoutY="55.0" prefWidth="180.0" promptText="Application ID" />

      <Label layoutX="340.0" layoutY="60.0" text="Applicant ID:" />
      <TextField fx:id="applicantIdTextField" layoutX="450.0" layoutY="55.0" prefWidth="180.0" promptText="Applicant ID" />

      <Label layoutX="20.0" layoutY="100.0" text="Decision:" />
      <ComboBox fx:id="approvalDecisionComboBox" layoutX="130.0" layoutY="95.0" prefWidth="180.0" />

      <Label layoutX="340.0" layoutY="100.0" text="Approval Date:" />
      <DatePicker fx:id="approvalDatePicker" layoutX="450.0" layoutY="95.0" prefWidth="180.0" />

      <CheckBox fx:id="notifyApplicantCheckBox" layoutX="130.0" layoutY="135.0" mnemonicParsing="false" text="Notify Applicant Email" />
      <Button fx:id="approveButton" layoutX="340.0" layoutY="130.0" mnemonicParsing="false" onAction="#handleApproveApplicantRegistration" prefWidth="150.0" text="Approve Registration" />

      <TableView fx:id="applicationTableView" layoutX="20.0" layoutY="175.0" prefHeight="300.0" prefWidth="710.0">
        <columns>
          <TableColumn fx:id="applicationIdColumn" prefWidth="110.0" text="Application ID" />
          <TableColumn fx:id="applicantIdColumn" prefWidth="110.0" text="Applicant ID" />
            <TableColumn fx:id="applicantNameColumn" prefWidth="140.0" text="Name" />
            <TableColumn fx:id="submissionDateColumn" prefWidth="110.0" text="Submission Date" />
            <TableColumn fx:id="verificationStatusColumn" prefWidth="120.0" text="Verification" />
            <TableColumn fx:id="approvalStatusColumn" prefWidth="110.0" text="Approval" />
        </columns>
      </TableView>
   </children>
</AnchorPane>

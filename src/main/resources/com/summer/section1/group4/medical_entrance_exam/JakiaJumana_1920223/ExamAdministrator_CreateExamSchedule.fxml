<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.group4medicalexamsimulation.JakiaJumana_1920223.Controller.ExamAdministrator_CreateExamScheduleController">
   <children>
      <Label layoutX="20.0" layoutY="20.0" text="Create Exam Schedule" />

      <Label layoutX="20.0" layoutY="60.0" text="Exam Date:" />
      <DatePicker fx:id="scheduleDatePicker" layoutX="120.0" layoutY="55.0" prefWidth="180.0" />

      <Label layoutX="330.0" layoutY="60.0" text="Start Time:" />
      <TextField fx:id="startTimeTextField" layoutX="430.0" layoutY="55.0" prefWidth="180.0" promptText="e.g. 10:00 AM" />

      <Label layoutX="20.0" layoutY="100.0" text="Duration (min):" />
      <TextField fx:id="durationTextField" layoutX="120.0" layoutY="95.0" prefWidth="180.0" promptText="e.g. 180" />

      <Label layoutX="330.0" layoutY="100.0" text="Exam Type:" />
      <ComboBox fx:id="examTypeComboBox" layoutX="430.0" layoutY="95.0" prefWidth="180.0" />

      <CheckBox fx:id="saveDraftCheckBox" layoutX="120.0" layoutY="135.0" mnemonicParsing="false" text="Save as Active Draft" />
      <Button fx:id="createButton" layoutX="330.0" layoutY="130.0" mnemonicParsing="false" onAction="#handleCreateExamSchedule" prefWidth="150.0" text="Create Schedule" />

      <TableView fx:id="scheduleTableView" layoutX="20.0" layoutY="175.0" prefHeight="300.0" prefWidth="660.0">
        <columns>
          <TableColumn fx:id="scheduleIdColumn" prefWidth="120.0" text="Schedule ID" />
          <TableColumn fx:id="examDateColumn" prefWidth="130.0" text="Exam Date" />
            <TableColumn fx:id="startTimeColumn" prefWidth="130.0" text="Start Time" />
            <TableColumn fx:id="durationMinutesColumn" prefWidth="140.0" text="Duration (Min)" />
            <TableColumn fx:id="isSavedColumn" prefWidth="130.0" text="Is Saved" />
        </columns>
      </TableView>
   </children>
</AnchorPane>

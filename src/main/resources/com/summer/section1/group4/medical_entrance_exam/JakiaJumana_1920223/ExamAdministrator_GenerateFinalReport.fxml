<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.group4medicalexamsimulation.JakiaJumana_1920223.Controller.ExamAdministrator_GenerateFinalReportController">
   <children>
      <Label layoutX="20.0" layoutY="20.0" text="Generate Final Report" />

      <Label layoutX="20.0" layoutY="60.0" text="Report Type:" />
      <ComboBox fx:id="reportTypeComboBox" layoutX="120.0" layoutY="55.0" prefWidth="180.0" />

      <Label layoutX="330.0" layoutY="60.0" text="Generated Date:" />
      <DatePicker fx:id="generatedDatePicker" layoutX="440.0" layoutY="55.0" prefWidth="180.0" />

      <Label layoutX="20.0" layoutY="100.0" text="Report Summary:" />
      <TextArea fx:id="reportDataTextArea" layoutX="120.0" layoutY="95.0" prefHeight="60.0" prefWidth="500.0" promptText="Summary and details..." />

      <CheckBox fx:id="includeAnalyticsCheckBox" layoutX="120.0" layoutY="165.0" mnemonicParsing="false" text="Include Analytics &amp; Charts" />
      <Button fx:id="generateButton" layoutX="330.0" layoutY="160.0" mnemonicParsing="false" onAction="#handleGenerateFinalReport" prefWidth="150.0" text="Generate Report" />

      <TableView fx:id="finalReportTableView" layoutX="20.0" layoutY="200.0" prefHeight="280.0" prefWidth="660.0">
        <columns>
          <TableColumn fx:id="reportIdColumn" prefWidth="120.0" text="Report ID" />
          <TableColumn fx:id="generatedDateColumn" prefWidth="130.0" text="Generated Date" />
            <TableColumn fx:id="reportTypeColumn" prefWidth="150.0" text="Report Type" />
            <TableColumn fx:id="reportDataColumn" prefWidth="250.0" text="Report Summary" />
        </columns>
      </TableView>
   </children>
</AnchorPane>

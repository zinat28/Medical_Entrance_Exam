<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group4.medical_entrance_exam.JakiaJumana_1920223.Controller.ExamCenterCoordinator_DownloadCenterDocumentController">
   <children>
      <Label layoutX="20.0" layoutY="20.0" text="Download Center Document" />

      <Label layoutX="20.0" layoutY="60.0" text="Center ID:" />
      <TextField fx:id="centerIdTextField" layoutX="140.0" layoutY="55.0" prefWidth="180.0" promptText="Center ID" />

      <Label layoutX="350.0" layoutY="60.0" text="Document Title:" />
      <TextField fx:id="documentTitleTextField" layoutX="470.0" layoutY="55.0" prefWidth="180.0" promptText="Document Title" />

      <Label layoutX="20.0" layoutY="100.0" text="File Format:" />
      <ComboBox fx:id="fileFormatComboBox" layoutX="140.0" layoutY="95.0" prefWidth="180.0" />

      <Label layoutX="350.0" layoutY="100.0" text="Download Date:" />
      <DatePicker fx:id="downloadDatePicker" layoutX="470.0" layoutY="95.0" prefWidth="180.0" />

      <CheckBox fx:id="verifyHashCheckBox" layoutX="140.0" layoutY="135.0" mnemonicParsing="false" text="Verify Security Hash" />
      <Button fx:id="downloadButton" layoutX="350.0" layoutY="130.0" mnemonicParsing="false" onAction="#handleDownloadCenterDocument" prefWidth="150.0" text="Download Doc" />

      <TableView fx:id="centerDocumentTableView" layoutX="20.0" layoutY="175.0" prefHeight="300.0" prefWidth="680.0">
        <columns>
          <TableColumn fx:id="documentIdColumn" prefWidth="110.0" text="Doc ID" />
          <TableColumn fx:id="centerIdColumn" prefWidth="110.0" text="Center ID" />
            <TableColumn fx:id="titleColumn" prefWidth="150.0" text="Title" />
            <TableColumn fx:id="fileFormatColumn" prefWidth="110.0" text="Format" />
            <TableColumn fx:id="downloadUrlColumn" prefWidth="190.0" text="Download URL" />
        </columns>
      </TableView>
   </children>
</AnchorPane>

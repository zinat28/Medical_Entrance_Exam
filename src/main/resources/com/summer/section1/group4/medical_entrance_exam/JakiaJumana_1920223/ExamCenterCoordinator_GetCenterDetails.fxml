<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group4.medical_entrance_exam.JakiaJumana_1920223.Controller.ExamCenterCoordinator_GetCenterDetailsController">
   <children>
      <Label layoutX="20.0" layoutY="20.0" text="Get Center &amp; Candidate Details" />

      <Label layoutX="20.0" layoutY="60.0" text="Center ID:" />
      <TextField fx:id="centerIdTextField" layoutX="120.0" layoutY="55.0" prefWidth="180.0" promptText="Center ID" />

      <Label layoutX="330.0" layoutY="60.0" text="Query Type:" />
      <ComboBox fx:id="queryTypeComboBox" layoutX="440.0" layoutY="55.0" prefWidth="180.0" />

      <Label layoutX="20.0" layoutY="100.0" text="As Of Date:" />
      <DatePicker fx:id="asOfDatePicker" layoutX="120.0" layoutY="95.0" prefWidth="180.0" />

      <CheckBox fx:id="includeCandidatesCheckBox" layoutX="330.0" layoutY="95.0" mnemonicParsing="false" text="Include Candidate Roster" />
      <Button fx:id="queryButton" layoutX="120.0" layoutY="130.0" mnemonicParsing="false" onAction="#handleGetCenterDetails" prefWidth="150.0" text="Query Center" />

      <TableView fx:id="capacityStatusTableView" layoutX="20.0" layoutY="175.0" prefHeight="300.0" prefWidth="660.0">
        <columns>
          <TableColumn fx:id="statusIdColumn" prefWidth="120.0" text="Status ID" />
          <TableColumn fx:id="centerIdColumn" prefWidth="130.0" text="Center ID" />
            <TableColumn fx:id="totalCapacityColumn" prefWidth="130.0" text="Total Capacity" />
            <TableColumn fx:id="allocatedSeatsColumn" prefWidth="140.0" text="Allocated Seats" />
            <TableColumn fx:id="availableSeatsColumn" prefWidth="130.0" text="Available Seats" />
        </columns>
      </TableView>
   </children>
</AnchorPane>

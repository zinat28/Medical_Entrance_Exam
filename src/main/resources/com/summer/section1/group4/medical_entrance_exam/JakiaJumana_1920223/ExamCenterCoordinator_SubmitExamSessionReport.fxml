<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="550.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.group4medicalexamsimulation.JakiaJumana_1920223.Controller.ExamCenterCoordinator_SubmitExamSessionReportController">
   <children>
      <Label layoutX="20.0" layoutY="20.0" text="Submit Exam Session Report" />

      <Label layoutX="20.0" layoutY="60.0" text="Center ID:" />
      <TextField fx:id="centerIdTextField" layoutX="140.0" layoutY="55.0" prefWidth="180.0" promptText="Center ID" />

      <Label layoutX="350.0" layoutY="60.0" text="Submission Time:" />
      <TextField fx:id="submissionTimeTextField" layoutX="470.0" layoutY="55.0" prefWidth="180.0" promptText="e.g. 12:00 PM" />

      <Label layoutX="20.0" layoutY="100.0" text="Session Status:" />
      <ComboBox fx:id="statusComboBox" layoutX="140.0" layoutY="95.0" prefWidth="180.0" />

      <Label layoutX="350.0" layoutY="100.0" text="Submission Date:" />
      <DatePicker fx:id="submissionDatePicker" layoutX="470.0" layoutY="95.0" prefWidth="180.0" />

      <Label layoutX="20.0" layoutY="140.0" text="Session Remarks:" />
      <TextArea fx:id="sessionRemarksTextArea" layoutX="140.0" layoutY="135.0" prefHeight="60.0" prefWidth="510.0" promptText="Enter session remarks..." />

      <CheckBox fx:id="signedByCoordinatorCheckBox" layoutX="140.0" layoutY="205.0" mnemonicParsing="false" text="Signed by Coordinator" />
      <Button fx:id="submitButton" layoutX="350.0" layoutY="200.0" mnemonicParsing="false" onAction="#handleSubmitExamSessionReport" prefWidth="150.0" text="Submit Report" />

      <TableView fx:id="examSessionReportTableView" layoutX="20.0" layoutY="240.0" prefHeight="290.0" prefWidth="680.0">
        <columns>
          <TableColumn fx:id="reportIdColumn" prefWidth="100.0" text="Report ID" />
          <TableColumn fx:id="generatedDateColumn" prefWidth="100.0" text="Gen Date" />
            <TableColumn fx:id="centerIdColumn" prefWidth="100.0" text="Center ID" />
            <TableColumn fx:id="sessionRemarksColumn" prefWidth="180.0" text="Remarks" />
            <TableColumn fx:id="submissionTimeColumn" prefWidth="100.0" text="Time" />
            <TableColumn fx:id="statusColumn" prefWidth="90.0" text="Status" />
        </columns>
      </TableView>
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group4.medical_entrance_exam.JubayerAhmed_2330814.Controller.FinanceOfficer_RevenueReportController">
   <children>
      <Label layoutX="20.0" layoutY="20.0" text="Generate Revenue Report" />
      
      <Label layoutX="20.0" layoutY="60.0" text="Institute ID:" />
      <TextField fx:id="instituteIdTextField" layoutX="170.0" layoutY="55.0" prefWidth="180.0" />
      
      <Label layoutX="380.0" layoutY="60.0" text="Report Type:" />
      <ComboBox fx:id="reportTypeComboBox" layoutX="530.0" layoutY="55.0" prefWidth="180.0" />
      
      <Label layoutX="20.0" layoutY="100.0" text="Start Date:" />
      <DatePicker fx:id="startDatePicker" layoutX="170.0" layoutY="95.0" prefWidth="180.0" />
      
      <Label layoutX="380.0" layoutY="100.0" text="End Date:" />
      <DatePicker fx:id="endDatePicker" layoutX="530.0" layoutY="95.0" prefWidth="180.0" />
      
      <CheckBox fx:id="includePendingCheckBox" layoutX="170.0" layoutY="140.0" text="Include Pending Clearance" />
      <Button fx:id="generateButton" layoutX="530.0" layoutY="135.0" mnemonicParsing="false" onAction="#handleGenerateRevenueReport" prefWidth="180.0" text="Generate Revenue Report" />
      
      <TableView fx:id="revenueReportTableView" layoutX="20.0" layoutY="180.0" prefHeight="280.0" prefWidth="760.0">
        <columns>
          <TableColumn fx:id="reportIdColumn" prefWidth="120.0" text="Report ID" />
          <TableColumn fx:id="generatedDateColumn" prefWidth="120.0" text="Generated Date" />
            <TableColumn fx:id="dateRangeColumn" prefWidth="160.0" text="Date Range" />
            <TableColumn fx:id="totalCollectedColumn" prefWidth="120.0" text="Total Collected" />
            <TableColumn fx:id="totalPendingColumn" prefWidth="120.0" text="Total Pending" />
            <TableColumn fx:id="totalRefundedColumn" prefWidth="120.0" text="Total Refunded" />
        </columns>
      </TableView>
   </children>
</AnchorPane>

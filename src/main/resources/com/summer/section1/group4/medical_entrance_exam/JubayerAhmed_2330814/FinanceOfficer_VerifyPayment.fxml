<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group4.medical_entrance_exam.JubayerAhmed_2330814.Controller.FinanceOfficer_VerifyPaymentController">
   <children>
      <Label layoutX="20.0" layoutY="20.0" text="Verify Application Payment" />
      
      <Label layoutX="20.0" layoutY="60.0" text="Transaction ID:" />
      <TextField fx:id="transactionIdTextField" layoutX="170.0" layoutY="55.0" prefWidth="180.0" />
      
      <Label layoutX="380.0" layoutY="60.0" text="Payment Gateway:" />
      <ComboBox fx:id="paymentGatewayComboBox" layoutX="530.0" layoutY="55.0" prefWidth="180.0" />
      
      <Label layoutX="20.0" layoutY="100.0" text="Payment Date:" />
      <DatePicker fx:id="paymentDatePicker" layoutX="170.0" layoutY="95.0" prefWidth="180.0" />
      
      <CheckBox fx:id="bankConfirmedCheckBox" layoutX="380.0" layoutY="100.0" text="Bank Confirmed" />
      <Button fx:id="verifyButton" layoutX="530.0" layoutY="135.0" mnemonicParsing="false" onAction="#handleVerifyPayment" prefWidth="180.0" text="Verify Payment" />
      
      <TableView fx:id="transactionTableView" layoutX="20.0" layoutY="180.0" prefHeight="280.0" prefWidth="760.0">
        <columns>
          <TableColumn fx:id="transactionIdColumn" prefWidth="120.0" text="Transaction ID" />
          <TableColumn fx:id="amountColumn" prefWidth="120.0" text="Amount" />
            <TableColumn fx:id="paymentDateColumn" prefWidth="130.0" text="Payment Date" />
            <TableColumn fx:id="bankReferenceColumn" prefWidth="140.0" text="Bank Reference" />
            <TableColumn fx:id="isReconciledColumn" prefWidth="120.0" text="Is Reconciled" />
            <TableColumn fx:id="statusColumn" prefWidth="130.0" text="Status" />
        </columns>
      </TableView>
   </children>
</AnchorPane>

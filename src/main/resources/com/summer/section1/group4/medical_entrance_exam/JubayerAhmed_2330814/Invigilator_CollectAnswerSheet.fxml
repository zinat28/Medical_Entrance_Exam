<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.group4medicalexamsimulation.JubayerAhmed_2330814.Controller.Invigilator_CollectAnswerSheetController">
   <children>
      <Label layoutX="20.0" layoutY="20.0" text="Collect Answer Sheet" />
      
      <Label layoutX="20.0" layoutY="60.0" text="Sheet Barcode:" />
      <TextField fx:id="sheetBarcodeTextField" layoutX="170.0" layoutY="55.0" prefWidth="180.0" />
      
      <Label layoutX="380.0" layoutY="60.0" text="Manifest ID:" />
      <TextField fx:id="manifestIdTextField" layoutX="530.0" layoutY="55.0" prefWidth="180.0" />
      
      <Label layoutX="20.0" layoutY="100.0" text="Collection Status:" />
      <ComboBox fx:id="collectionStatusComboBox" layoutX="170.0" layoutY="95.0" prefWidth="180.0" />
      
      <Label layoutX="380.0" layoutY="100.0" text="Collection Date:" />
      <DatePicker fx:id="collectionDatePicker" layoutX="530.0" layoutY="95.0" prefWidth="180.0" />
      
      <CheckBox fx:id="verifiedBarcodeCheckBox" layoutX="170.0" layoutY="140.0" text="Scanned Barcode Verified" />
      <Button fx:id="collectButton" layoutX="530.0" layoutY="135.0" mnemonicParsing="false" onAction="#handleCollectAnswerSheet" prefWidth="180.0" text="Collect Answer Sheet" />
      
      <TableView fx:id="answerSheetTableView" layoutX="20.0" layoutY="180.0" prefHeight="280.0" prefWidth="760.0">
        <columns>
          <TableColumn fx:id="barcodeColumn" prefWidth="190.0" text="Sheet Barcode" />
          <TableColumn fx:id="serialNumberColumn" prefWidth="190.0" text="Serial Number" />
            <TableColumn fx:id="isExtraSheetColumn" prefWidth="190.0" text="Is Extra Sheet" />
            <TableColumn fx:id="collectionStatusColumn" prefWidth="190.0" text="Collection Status" />
        </columns>
      </TableView>
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group4.medical_entrance_exam.JubayerAhmed_2330814.Controller.Invigilator_ReVerifyCandidateController">
   <children>
      <Label layoutX="20.0" layoutY="20.0" text="Re-Verify Candidate Identity" />
      
      <Label layoutX="20.0" layoutY="60.0" text="Candidate Roll Number:" />
      <TextField fx:id="rollNumberTextField" layoutX="170.0" layoutY="55.0" prefWidth="180.0" />
      
      <Label layoutX="380.0" layoutY="60.0" text="Re-Verification Reason:" />
      <ComboBox fx:id="reasonComboBox" layoutX="530.0" layoutY="55.0" prefWidth="180.0" />
      
      <Label layoutX="20.0" layoutY="100.0" text="Re-Verification Date:" />
      <DatePicker fx:id="reVerifyDatePicker" layoutX="170.0" layoutY="95.0" prefWidth="180.0" />
      
      <CheckBox fx:id="biometricMatchCheckBox" layoutX="380.0" layoutY="100.0" text="Biometric Match Confirmed" />
      <Button fx:id="reVerifyButton" layoutX="530.0" layoutY="135.0" mnemonicParsing="false" onAction="#handleReVerifyCandidate" prefWidth="180.0" text="Execute Re-Verification" />
      
      <TableView fx:id="candidateTableView" layoutX="20.0" layoutY="180.0" prefHeight="280.0" prefWidth="760.0">
        <columns>
          <TableColumn fx:id="candidateIdColumn" prefWidth="190.0" text="Candidate ID" />
          <TableColumn fx:id="rollNumberColumn" prefWidth="190.0" text="Roll Number" />
            <TableColumn fx:id="nameColumn" prefWidth="190.0" text="Candidate Name" />
            <TableColumn fx:id="assignedHallIdColumn" prefWidth="190.0" text="Assigned Hall" />
        </columns>
      </TableView>
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.summer.section1.group4.medical_entrance_exam.tanvir.user7user8.controller.ApproveCandidatesController"
      alignment="CENTER"
      spacing="15"
      prefWidth="950"
      prefHeight="580">

    <padding>
        <Insets top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>

    <Label text="Director Candidate Approval"
           style="-fx-font-size: 24px;
                  -fx-font-weight: bold;"/>

    <Label text="Only candidates with verified documents can be approved."
           style="-fx-text-fill: #666666;"/>

    <TableView fx:id="candidateTable"
               prefWidth="900"
               prefHeight="420">

        <columns>

            <TableColumn fx:id="idColumn"
                         text="ID"
                         prefWidth="65"/>

            <TableColumn fx:id="nameColumn"
                         text="Name"
                         prefWidth="210"/>

            <TableColumn fx:id="rollColumn"
                         text="Roll"
                         prefWidth="150"/>

            <TableColumn fx:id="gpaColumn"
                         text="GPA"
                         prefWidth="100"/>

            <TableColumn fx:id="documentsColumn"
                         text="Documents"
                         prefWidth="150"/>

            <TableColumn fx:id="statusColumn"
                         text="Status"
                         prefWidth="130"/>

            <TableColumn fx:id="approvalColumn"
                         text="Director Approval"
                         prefWidth="170"/>

        </columns>

    </TableView>

    <HBox alignment="CENTER"
          spacing="15">

        <Button text="Approve Candidate"
                prefWidth="170"
                onAction="#handleApproveCandidate"/>

        <Button text="Remove Approval"
                prefWidth="160"
                onAction="#handleRemoveApproval"/>

        <Button text="Refresh"
                prefWidth="120"
                onAction="#handleRefresh"/>

        <Button text="Close"
                prefWidth="120"
                onAction="#handleClose"/>

    </HBox>

</VBox>
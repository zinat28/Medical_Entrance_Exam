<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.summer.section1.group4.medical_entrance_exam.tanvir.user7user8.controller.EditCandidateController"
      alignment="CENTER"
      spacing="20"
      prefWidth="500"
      prefHeight="430">

    <padding>
        <Insets top="25"
                right="25"
                bottom="25"
                left="25"/>
    </padding>

    <Label text="Edit Candidate"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <GridPane alignment="CENTER"
              hgap="15"
              vgap="15">

        <Label text="Name:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField fx:id="nameField"
                   prefWidth="250"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <Label text="Roll:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <TextField fx:id="rollField"
                   prefWidth="250"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <Label text="GPA:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <TextField fx:id="gpaField"
                   prefWidth="250"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>

        <Label text="Status:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <ComboBox fx:id="statusComboBox"
                  prefWidth="250"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="3"/>

    </GridPane>

    <HBox alignment="CENTER"
          spacing="15">

        <Button text="Save"
                prefWidth="110"
                onAction="#handleSave"/>

        <Button text="Cancel"
                prefWidth="110"
                onAction="#handleCancel"/>

    </HBox>

    <Label fx:id="messageLabel"
           text=""
           wrapText="true"/>

</VBox>
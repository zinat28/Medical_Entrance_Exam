<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="268.0" prefWidth="349.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.summer.section1.group4.medical_entrance_exam.tanvir.user7user8.controller.LoginController">

    <children>

        <Label layoutX="120" layoutY="40" text="Medical Entrance Exam Login" />

        <TextField fx:id="usernameField" layoutX="120" layoutY="100" promptText="Username" />

        <PasswordField fx:id="passwordField" layoutX="120" layoutY="150" promptText="Password" />

        <Button layoutX="160" layoutY="200" onAction="#login" text="Login" />

        <Label fx:id="messageLabel" layoutX="120" layoutY="250" />

    </children>

</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Pos?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.summer.section1.group4.medical_entrance_exam.tanvir.user7user8.controller.MedicalOfficerDashboardController"
      alignment="CENTER"
      spacing="20"
      prefHeight="400"
      prefWidth="500">


    <Label text="Welcome Medical Officer"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>


    <Button text="View Candidates"
            prefWidth="200"
            onAction="#handleViewCandidates"/>


    <Button text="Verify Documents"
            prefWidth="200"
            onAction="#handleVerifyDocuments"/>


    <Button text="Logout"
            prefWidth="200"
            onAction="#handleLogout"/>


</VBox>
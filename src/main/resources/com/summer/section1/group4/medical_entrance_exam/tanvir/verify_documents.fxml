<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.summer.section1.group4.medical_entrance_exam.tanvir.user7user8.controller.VerifyDocumentsController"
      alignment="CENTER"
      spacing="15"
      prefWidth="850"
      prefHeight="550">

    <padding>
        <Insets top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>

    <Label text="Candidate Document Verification"
           style="-fx-font-size: 24px;
                  -fx-font-weight: bold;"/>

    <Label text="Select a candidate and update the document verification status."
           style="-fx-text-fill: #666666;"/>

    <TableView fx:id="candidateTable"
               prefWidth="800"
               prefHeight="400">

        <columns>

            <TableColumn fx:id="idColumn"
                         text="ID"
                         prefWidth="70"/>

            <TableColumn fx:id="nameColumn"
                         text="Name"
                         prefWidth="230"/>

            <TableColumn fx:id="rollColumn"
                         text="Roll"
                         prefWidth="170"/>

            <TableColumn fx:id="statusColumn"
                         text="Candidate Status"
                         prefWidth="160"/>

            <TableColumn fx:id="verificationColumn"
                         text="Documents"
                         prefWidth="170"/>

        </columns>

    </TableView>

    <HBox alignment="CENTER"
          spacing="15">

        <Button text="Verify Documents"
                prefWidth="170"
                onAction="#handleVerifyDocuments"/>

        <Button text="Mark Not Verified"
                prefWidth="170"
                onAction="#handleMarkNotVerified"/>

        <Button text="Refresh"
                prefWidth="120"
                onAction="#handleRefresh"/>

        <Button text="Close"
                prefWidth="120"
                onAction="#handleClose"/>

    </HBox>

</VBox>
            <Button fx:id="DocumentUploadsBTN" mnemonicParsing="false" onAction="#handleMenuSelection" prefHeight="40.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: BASELINE_LEFT;" text="2. Document Uploads" wrapText="true">

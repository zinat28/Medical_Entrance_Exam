            <Label text="Mark Per Wrong Answer" GridPane.rowIndex="1">
               <font>
                  <Font name="Bell MT" size="18.0" />
               </font>
            </Label>
         </children>
      </GridPane>
      <Button layoutX="139.0" layoutY="596.0" mnemonicParsing="false" onAction="#ApplyGradingConfigureOA" style="-fx-background-color: #006643;" text="Apply Grading Configuration" textFill="WHITE">
         <font>
            <Font name="Bell MT Bold" size="24.0" />
         </font>
      </Button>
      <Label fx:id="GradingConfigureStatusLabel" alignment="TOP_CENTER" contentDisplay="TOP" layoutX="50.0" layoutY="666.0" prefHeight="112.0" prefWidth="500.0" text="STATUS: Awaiting for grading configuration." textAlignment="CENTER" textFill="#068053" wrapText="true">
         <font>
            <Font name="Bell MT Bold" size="22.0" />
         </font>
      </Label>

<?import javafx.scene.text.Font?>

<AnchorPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="600.0" style="-fx-padding: 30;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer.section1.group4.medical_entrance_exam.zinat.QuestionModerator.MarkDistributionController">
   <children>
      <Label alignment="CENTER" layoutX="114.0" layoutY="108.0" prefHeight="165.0" prefWidth="391.0" text="Set Awarded &amp; Negative Marking" textAlignment="CENTER" textFill="#082c5e" wrapText="true">
         <font>
            <Font name="Bell MT Bold" size="37.0" />
         </font>
      </Label>
      <GridPane hgap="20.0" layoutX="50.0" layoutY="355.0" prefHeight="39.0" prefWidth="500.0" vgap="15.0">
         <columnConstraints>
            <ColumnConstraints maxWidth="248.0" minWidth="120.0" prefWidth="238.5" />
            <ColumnConstraints maxWidth="355.5" minWidth="200.0" prefWidth="241.5" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="30.0" />
            <RowConstraints minHeight="30.0" />
         </rowConstraints>
         <children>
            <Label text="Mark Per Correct Answer">
               <font>
                  <Font name="Bell MT" size="18.0" />
               </font>
            </Label>
            <TextField fx:id="AwardedMarkTF" prefHeight="40.0" prefWidth="304.0" promptText="Awarded Mark" GridPane.columnIndex="1">
